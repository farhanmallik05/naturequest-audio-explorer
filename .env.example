# NatureQuest Audio Explorer - Environment Variables

# Open-Weight AI Generation: Gemma via Groq (Primary recommended provider)
GROQ_API_KEY=gsk_...

# Alternative / Fallback LLM Endpoint (Optional)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Audio Guide Voice Synthesis: ElevenLabs
ELEVENLABS_API_KEY=xi_...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Local Nature Spot Discovery: SerpApi
SERPAPI_API_KEY=...

# Persistent Memory & Quest History: MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Error & Performance Monitoring: Sentry (Optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
